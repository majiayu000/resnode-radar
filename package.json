{
  "name": "resnode-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "VPS stock monitor and owner-run review site.",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/majiayu000/resnode-radar.git"
  },
  "bugs": {
    "url": "https://github.com/majiayu000/resnode-radar/issues"
  },
  "scripts": {
    "check": "find . -maxdepth 1 -name '*.js' -print0 | xargs -0 -n1 node --check && find scripts -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "assets": "node scripts/generate-assets.mjs",
    "monitor": "node scripts/monitor.mjs",
    "monitor:validate": "node scripts/validate-monitor-data.mjs",
    "serve": "python3 -m http.server 4173"
  },
  "dependencies": {
    "node-html-parser": "7.0.1"
  }
}
